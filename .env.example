# Telegram API Credentials (https://my.telegram.org)
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=your_api_hash_here

# Database: Turso (libSQL) / Local SQLite
# For remote Turso: libsql://[database-name]-[org-name].turso.io
# For local SQLite: file:teledrive.db
TURSO_DATABASE_URL=file:teledrive.db
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# JWT Secret
JWT_SECRET=your-secret-key-change-this-in-production

# Encryption key for Telegram sessions (32 bytes hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Allowed phone numbers (comma-separated, e.g. +628123456,+628765432)
ALLOWED_PHONES=+628123456789

# Server Port
PORT=8080
